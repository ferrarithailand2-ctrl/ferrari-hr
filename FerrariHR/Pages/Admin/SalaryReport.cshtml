@page
@model FerrariHR.Pages.Admin.SalaryReportModel
@{
    ViewData["Title"] = "Salary report";
}

<h1 class="text-2xl font-semibold text-ferrariDark mt-4 mb-4">
    Salary report (Excel)
</h1>

<section class="bg-white shadow-md rounded-lg p-4 mb-4">
    <form method="post">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label asp-for="Year" class="block text-sm font-medium text-gray-700">Year</label>
                <input asp-for="Year"
                       class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
                <span asp-validation-for="Year" class="text-sm text-red-500"></span>
            </div>

            <div>
                <label asp-for="Month" class="block text-sm font-medium text-gray-700">Month (1–12)</label>
                <input asp-for="Month"
                       class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
                <span asp-validation-for="Month" class="text-sm text-red-500"></span>
            </div>
        </div>

        <button type="submit"
                class="mt-4 bg-ferrariRed text-white px-4 py-2 rounded-md font-semibold hover:bg-red-700 transition">
            Export to Excel
        </button>
    </form>
</section>

<p class="text-sm text-gray-600">
    Exports salary report for the selected month using Salary Config + Approved Overtime + Late summary.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
