@page
@model FerrariHR.Pages.Admin.LateSummaryModel
@{
    ViewData["Title"] = "Late Summary (Monthly)";
}

<h1 class="text-2xl font-semibold text-ferrariDark mt-4 mb-4">
    Late summary (monthly)
</h1>

<form method="get" class="mb-4 flex items-end gap-3">
    <div>
        <label asp-for="Year" class="block text-sm font-medium text-gray-700">Year</label>
        <input asp-for="Year"
               class="mt-1 block w-24 border-gray-300 rounded-md shadow-sm" />
    </div>
    <div>
        <label asp-for="Month" class="block text-sm font-medium text-gray-700">Month</label>
        <input asp-for="Month"
               class="mt-1 block w-16 border-gray-300 rounded-md shadow-sm" />
    </div>
    <button type="submit"
            class="h-9 px-4 bg-ferrariRed text-white rounded-md font-semibold hover:bg-red-700 transition">
        Apply
    </button>
</form>

@if (Model.Records == null || !Model.Records.Any())
{
    <p class="text-sm text-gray-500">
        No late records found for @Model.Year-@Model.Month.
    </p>
}
else
{
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <table class="min-w-full text-sm">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Employee</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Email</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Year</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Month</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Work days</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Late days</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Total late (minutes)</th>
                    <th class="px-3 py-2 text-left font-medium text-gray-700">Total late (hours)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Records)
            {
                <tr class="border-t">
                    <td class="px-3 py-2">@row.EmployeeName</td>
                    <td class="px-3 py-2">@row.EmployeeEmail</td>
                    <td class="px-3 py-2">@row.Late.Year</td>
                    <td class="px-3 py-2">@row.Late.Month</td>
                    <td class="px-3 py-2">@row.Late.WorkDays</td>
                    <td class="px-3 py-2">@row.Late.LateDays</td>
                    <td class="px-3 py-2">@row.Late.TotalLateMinutes</td>
                    <td class="px-3 py-2">@row.Late.TotalLateHours</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
