@page
@model FerrariHR.Pages.Admin.SalaryModel
@{
    ViewData["Title"] = "Salary Calculation";
}

<h1 class="text-2xl font-semibold text-ferrariDark mt-4 mb-4">
    Salary calculation
</h1>

<section class="bg-white shadow-md rounded-lg p-4 mb-4">
    <form method="post" class="flex flex-wrap items-end gap-4">
        <div>
            <label class="block text-sm font-medium text-gray-700">Year</label>
            <select asp-for="SelectedYear"
                    class="mt-1 block border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed">
                @foreach (var y in Model.YearOptions)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Month</label>
            <select asp-for="SelectedMonth"
                    class="mt-1 block border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">
                        @($"{m:00}")
                    </option>
                }
            </select>
        </div>

        <button type="submit"
                class="bg-ferrariRed text-white px-4 py-2 rounded-md font-semibold hover:bg-red-700 transition">
            Calculate
        </button>
    </form>
</section>

<section class="bg-white shadow-md rounded-lg p-4">
    <h2 class="text-lg font-semibold text-ferrariDark mb-3">
        Results for @Model.SelectedYear-@Model.SelectedMonth.ToString("00")
    </h2>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <p class="text-sm text-gray-500">
            No salary configuration found. Import salary config and late summary, and ensure there are approved OT entries.
        </p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-3 py-2 text-left font-medium text-gray-700">Employee</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-700">Email</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Base salary</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">OT hours</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">OT pay</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Work days</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Late days</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Late minutes</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Late deduction</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-700">Total salary</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr class="border-t">
                        <td class="px-3 py-2">@row.UserName</td>
                        <td class="px-3 py-2">@row.Email</td>
                        <td class="px-3 py-2 text-right">@row.BaseSalary.ToString("N2")</td>
                        <td class="px-3 py-2 text-right">@row.OvertimeHours.ToString("0.00")</td>
                        <td class="px-3 py-2 text-right">@row.OvertimePay.ToString("N2")</td>
                        <td class="px-3 py-2 text-right">@row.WorkDays</td>
                        <td class="px-3 py-2 text-right">@row.LateDays</td>
                        <td class="px-3 py-2 text-right">@row.LateMinutes</td>
                        <td class="px-3 py-2 text-right text-red-600">-@row.LateDeduction.ToString("N2")</td>
                        <td class="px-3 py-2 text-right font-semibold">@row.TotalSalary.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
