@page
@model FerrariHR.Pages.Admin.EditUserModel
@{
    ViewData["Title"] = "Edit User";
}

<h1 class="text-2xl font-semibold text-ferrariDark mt-4 mb-4">
    Edit user
</h1>

<div class="max-w-lg bg-white shadow-md rounded-lg p-4">
    <form method="post" class="space-y-4">
        <input type="hidden" asp-for="Input.Id" />

        <div>
            <label asp-for="Input.UserName" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Input.UserName"
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
            <span asp-validation-for="Input.UserName" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Input.Email"
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
            <span asp-validation-for="Input.Email" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.NewPassword" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Input.NewPassword"
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
            <span class="text-xs text-gray-500">
                Leave blank to keep the current password.
            </span>
            <span asp-validation-for="Input.NewPassword" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Input.ConfirmPassword"
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-ferrariRed focus:border-ferrariRed" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-600"></span>
        </div>

        <div class="flex gap-2">
            <button type="submit"
                    class="bg-ferrariRed text-white px-4 py-2 rounded-md font-semibold hover:bg-red-700 transition">
                Save changes
            </button>
            <a asp-page="/Admin/Users"
               class="px-4 py-2 rounded-md border border-gray-300 text-sm hover:bg-gray-100">
                Cancel
            </a>
        </div>
    </form>

    <div class="mt-3 text-xs text-gray-500">
        Changing <strong>User name</strong> may affect mapping with HR Excel
        (Late &amp; future Salary features use UserName as Employee Name). Use carefully.
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
